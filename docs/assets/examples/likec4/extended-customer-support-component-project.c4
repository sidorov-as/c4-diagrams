specification {
  color user #66bb6a
  color frontend #42a5f5
  color gateway #ec407a
  color backend #7e57c2
  color worker #fb8c00
  color database #ffb300
  color queue #26a69a
  color external #9e9e9e
  element actor {
    notation "Person"
    style {
      color user
      shape person
    }
  }
  element system { style { color primary } }
  element external {
    notation "External system"
    style { color external }
  }
  element frontend {
    notation "Frontend"
    style {
      color frontend
      shape browser
    }
  }
  element gateway {
    notation "API gateway"
    style { color gateway }
  }
  element backend {
    notation "Backend service"
    style {
      color backend
      shape component
    }
  }
  element worker {
    notation "Background worker"
    style {
      color worker
      shape component
    }
  }
  element database {
    notation "Datastore"
    style {
      color database
      shape storage
    }
  }
  element queue {
    notation "Event stream"
    style {
      color queue
      shape queue
    }
  }
  relationship sync { color sky }
  relationship data { color amber }
  relationship async {
    color green
    line dotted
  }
  relationship external-call {
    color muted
    line dashed
  }
}

model {
  administrator = actor "Administrator" { description '''Internal user with administrative access.''' }
  customer = actor "Customer" { description '''Owner of electronic equipment and support plan; reports issues.''' }
  helpdesk = actor "Helpdesk" { description '''First line of support; provides direct phone support.''' }
  manager = actor "Manager" { description '''Monitors expert performance and customer satisfaction.''' }
  support_expert = actor "Support Expert" { description '''Technology expert who fixes customer electronic devices.''' }
  auth0 = external "Auth0" {
    description '''External identity provider for authentication.'''
    technology "OIDC/OAuth2"
  }
  email_system = external "E-mail System" {
    description '''Internal mail system used for e-mail delivery.'''
    technology "SMTP"
  }
  payment_provider = external "Payment Service Provider" {
    description '''External online payment service.'''
    technology "HTTPS/API"
  }
  sms_provider = external "SMS Service Provider" {
    description '''Provides SMS text messaging.'''
    technology "SMS API"
  }
  support = system "Customer Support System" {
    description '''Components that handle support tickets and expert assignments.'''
    admin_api = backend "Admin API" {
      description '''User management and reference-data management.'''
      technology "Container Service"
    }
    admin_portal = frontend "Admin Portal" {
      description '''Manages system users and reference data.'''
      technology "Single-page Application"
    }
    analytics_api = backend "Analytics API" {
      description '''Ticket status reports, survey analysis and performance reports.'''
      technology "Container Service"
    }
    api_gateway = gateway "API Gateway" {
      description '''Performs access control, security checks and request routing.'''
      technology "Container Service"
    }
    billing_api = backend "Billing API" {
      description '''Billing management and financial reports.'''
      technology "Container Service"
    }
    billing_portal = frontend "Billing Portal" {
      description '''Supports billing processing.'''
      technology "Single-page Application"
    }
    customer_api = backend "Customer API" {
      description '''Handles registration, profiles, tickets, surveys and billing history.'''
      technology "Container Service"
    }
    customer_notifications_queue = queue "Customer Notifications" {
      description '''Asynchronous message channel for customer notifications.'''
      technology "Message Queue"
    }
    customer_portal = frontend "Customer Portal" {
      description '''Provides access to customer profile, billing, ticket creation and history.'''
      technology "Single-page Application"
    }
    expert_notifications_queue = queue "Expert Notifications" {
      description '''Asynchronous message channel for expert notifications.'''
      technology "Message Queue"
    }
    helpdesk_portal = frontend "Helpdesk Portal" {
      description '''Provides access to tickets and status.'''
      technology "Single-page Application"
    }
    invoice_queue = queue "Invoice" {
      description '''Asynchronous message channel for invoice processing.'''
      technology "Message Queue"
    }
    knowledge_base = frontend "Knowledge Base" {
      description '''Supports searching and updating knowledge-base articles.'''
      technology "Single-page Application"
    }
    mobile_app = frontend "Mobile App" {
      description '''Provides access to assigned tickets and knowledge-base search.'''
      technology "iOS / Android App"
    }
    notification_service = backend "Notification Service" {
      description '''Sends SMS and e-mail messages based on notification preferences.'''
      technology "Container Service"
    }
    payment_job = worker "Payment" {
      description '''Runs monthly and performs payment operations.'''
      technology "Container Job"
    }
    support_api = backend "Support API" {
      description '''Ticket orchestration, search, assignment handling and knowledge-base updates.'''
      technology "Container Service"
    }
    support_dashboard = frontend "Support Dashboard" {
      description '''Provides analytics and operational reports.'''
      technology "Single-page Application"
    }
    support_database = database "Support Database" {
      description '''Stores tickets, users, customer contacts and knowledge-base content.'''
      technology "Relational Database"
    }
    ticket_assigned_queue = queue "Ticket Assigned" {
      description '''Asynchronous message channel for assigned tickets.'''
      technology "Message Queue"
    }
    ticket_created_queue = queue "Ticket Created" {
      description '''Asynchronous message channel for created tickets.'''
      technology "Message Queue"
    }
    ticket_processor = worker "Ticket Processor" {
      description '''Runs periodically, scans ticket statuses, and creates assignments.'''
      technology "Container Job"
    }
    ticket_progress_queue = queue "Ticket In-Progress/Closed" {
      description '''Asynchronous message channel for ticket progress and closure notifications.'''
      technology "Message Queue"
    }
  }
  support.admin_api -[data]-> support.support_database "Reads from and writes to" { technology "SQL/TCP" }
  support.admin_portal -[sync]-> support.api_gateway "Makes API calls to" { technology "REST/HTTPS" }
  support.analytics_api -[data]-> support.support_database "Reads from and writes to" { technology "SQL/TCP" }
  support.api_gateway -[sync]-> support.customer_api "Routes API calls to" { technology "REST/HTTP" }
  support.api_gateway -[sync]-> support.support_api "Routes API calls to" { technology "REST/HTTP" }
  support.api_gateway -[sync]-> support.admin_api "Routes API calls to" { technology "REST/HTTP" }
  support.api_gateway -[sync]-> support.billing_api "Routes API calls to" { technology "REST/HTTP" }
  support.api_gateway -[sync]-> support.analytics_api "Routes API calls to" { technology "REST/HTTP" }
  support.billing_api -[data]-> support.support_database "Reads from and writes to" { technology "SQL/TCP" }
  support.billing_portal -[sync]-> support.api_gateway "Makes API calls to" { technology "REST/HTTPS" }
  support.customer_api -[data]-> support.support_database "Reads from and writes to" { technology "SQL/TCP" }
  support.customer_api -[async]-> support.ticket_created_queue "Sends ticket created event" { technology "Queue / Event" }
  support.customer_portal -[external-call]-> auth0 "Authenticates using" { technology "OIDC/OAuth2" }
  support.customer_portal -[sync]-> support.api_gateway "Makes API calls to" { technology "REST/HTTPS" }
  support.helpdesk_portal -[sync]-> support.api_gateway "Makes API calls to" { technology "REST/HTTPS" }
  support.knowledge_base -[sync]-> support.api_gateway "Makes API calls to" { technology "REST/HTTPS" }
  support.mobile_app -[external-call]-> auth0 "Authenticates using" { technology "OIDC/OAuth2" }
  support.mobile_app -[sync]-> support.api_gateway "Makes API calls to" { technology "REST/HTTPS" }
  support.notification_service -[data]-> support.support_database "Reads from and writes to" { technology "SQL/TCP" }
  support.notification_service -[external-call]-> email_system "Sends e-mail using" { technology "SMTP" }
  support.notification_service -[external-call]-> sms_provider "Sends SMS using" { technology "SMS API" }
  support.payment_job -[data]-> support.support_database "Reads from and writes to" { technology "SQL/TCP" }
  support.payment_job -[async]-> support.invoice_queue "Sends invoice event" { technology "Queue / Event" }
  support.payment_job -[external-call]-> payment_provider "Executes payments using" { technology "HTTPS/API" }
  support.support_api -[data]-> support.support_database "Reads from and writes to" { technology "SQL/TCP" }
  support.support_api -[async]-> support.expert_notifications_queue "Sends expert notification event" { technology "Queue / Event" }
  support.support_api -[async]-> support.customer_notifications_queue "Sends customer notification event" { technology "Queue / Event" }
  support.support_api -[async]-> support.ticket_progress_queue "Sends progress/closed event" { technology "Queue / Event" }
  support.support_dashboard -[sync]-> support.api_gateway "Makes API calls to" { technology "REST/HTTPS" }
  support.ticket_processor -[data]-> support.support_database "Reads from and writes to" { technology "SQL/TCP" }
  support.ticket_processor -[async]-> support.ticket_assigned_queue "Sends ticket assignment event" { technology "Queue / Event" }
  administrator -[sync]-> support.admin_portal "Maintains users and reference data" { technology "HTTPS" }
  administrator -[sync]-> support.billing_portal "Manages billing operations" { technology "HTTPS" }
  customer -[sync]-> support.customer_portal "Uses" { technology "HTTPS" }
  customer -[sync]-> support.mobile_app "Uses" { technology "HTTPS" }
  helpdesk -[sync]-> support.helpdesk_portal "Creates/searches tickets" { technology "HTTPS" }
  manager -[sync]-> support.support_dashboard "Tracks operations and generates reports" { technology "HTTPS" }
  support_expert -[sync]-> support.mobile_app "Uses" { technology "HTTPS" }
  support_expert -[sync]-> support.knowledge_base "Updates articles" { technology "HTTPS" }
  support.customer_notifications_queue -[async]-> support.notification_service "Consumed by" { technology "Queue / Event" }
  support.expert_notifications_queue -[async]-> support.notification_service "Consumed by" { technology "Queue / Event" }
  support.invoice_queue -[async]-> support.api_gateway "Calls billing APIs through" { technology "REST/HTTP" }
  support.ticket_assigned_queue -[async]-> support.support_api "Consumed by" { technology "Queue / Event" }
  support.ticket_created_queue -[async]-> support.ticket_processor "Consumed by" { technology "Queue / Event" }
  support.ticket_progress_queue -[async]-> support.customer_api "Consumed by" { technology "Queue / Event" }
}

views {
  view components of support {
    title "Customer Support System - Extended Component View"
    include *
    autoLayout TopBottom
  }
}
