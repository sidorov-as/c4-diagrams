@startuml
' convert it with additional command line argument -DRELATIVE_INCLUDE="relative/absolute" to use locally
!if %variable_exists("RELATIVE_INCLUDE")
    !include %get_variable_value("RELATIVE_INCLUDE")/C4_Dynamic.puml
!else
    !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Dynamic.puml
!endif

title Checkout Flow

Person(customer, "Customer", "Places an order in the online store.")

System(retail_platform, "Retail Platform", "Coordinates checkout and order processing.")

System_Ext(payment_provider, "Payment Provider", "Authorizes card payments.")

System_Ext(warehouse_system, "Warehouse System", "Reserves stock and starts fulfillment.")

Rel(customer, retail_platform, "Submits checkout", "HTTPS")
Rel(retail_platform, payment_provider, "Authorizes payment", "HTTPS")
Rel(retail_platform, warehouse_system, "Reserves stock", "HTTPS")
Rel(retail_platform, customer, "Confirms order", "HTTPS")

@enduml
